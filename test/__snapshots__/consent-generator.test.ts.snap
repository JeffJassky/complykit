r.test","label":"tracker.test","category":"advertising","control":"none","stores":[],"note":"not classified: strictest category; loader not identified: not controlled"}],"gate":[{"category":"analytics","src":"^(?:https?:)?//www\\\\.googletagmanager\\\\.com/gtag/js","vendor":"google.analytics"}],"gtm":{"containers":["GTM-XXXX01"],"dataLayer":"dataLayer","consentMode":{"ad_storage":"advertising","ad_user_data":"advertising","ad_personalization":"advertising","analytics_storage":"analytics","security_storage":"necessary"},"tags":[{"name":"GTM-XXXX01 tag 7 (Custom template)","category":"advertising","vendor":"tiktok.pixel"}]},"platform":"shopify","theme":{},"strings":{},"consent":{"lifetimeDays":365},"layout":"bar"}</script>
