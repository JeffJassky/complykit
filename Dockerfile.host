# complykit host (plans/do-hosting.md): the web UI/API and the scan orchestrator,
# for DigitalOcean App Platform. No browsers: every scan runs on a Fly worker
# (the full Dockerfile). The complykit CLI is included for the host's own
# browser-free commands (report re-render, consent-config, kb); playwright is
# present as a module only because the CLI imports it, never launched here.

# --- build ---------------------------------------------------------------------
FROM node:22-bookworm AS build
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY service/package.json service/package-lock.json ./service/
RUN cd service && npm ci --no-audit --no-fund

COPY client/package.json client/package-lock.json ./client/
RUN cd client && npm ci --no-audit --no-fund

COPY . .
RUN npm run build && (cd client && npm run build) && cd service && npm run build

# --- runtime -------------------------------------------------------------------
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PORT=8080 \
    DATA_DIR=/data \
    COMPLYKIT_KB_DIR=/data/kb

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/node_modules/playwright ./node_modules/playwright
COPY --from=build /app/node_modules/playwright-core ./node_modules/playwright-core
COPY --from=build /app/dist ./dist

COPY service/package.json service/package-lock.json ./service/
RUN cd service && npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/service/dist ./service/dist
COPY --from=build /app/client/dist/complykit-consent.js /app/client/dist/complykit-consent-ui.js /app/client/dist/complykit-consent-companion.js /app/client/dist/complykit-build.json ./client/dist/

# Scratch only: App Platform's disk is ephemeral; files and records live in Spaces and Mongo.
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "service/dist/server/index.js"]
